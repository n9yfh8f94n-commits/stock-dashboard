# ============================================================
# A股复盘系统 · 公开仓库忽略清单
# ------------------------------------------------------------
# 上传原则：
#   ✅ 上游源码（*.py）、README、daily.bat、requirements.txt
#   ✅ docs/index.html（朋友访问的那一个文件）
#   ❌ 其余全部：行情快照、校准库、日志、中间产物、第三方 JS
#
# 为什么 cache/ 绝对不能传：
#   它是本系统最核心的资产（每天几十个 CSV，累积久了是几个 GB），
#   而且里面有全市场个股明细。传到公开仓库既不必要也存在合规风险。
# ============================================================

# ---- 原始行情快照：体积大、含全市场明细，不公开 ----
cache/

# ---- 校准数据与长期指标库（metrics_history.csv）----
calibration/

# ---- 每日产出：报告本体已复制到 docs/index.html，原始产物不上传 ----
# （保留本地是为了你能回看历史，同时避免仓库每天增长 1MB）
reports/

# ---- 运行日志 ----
logs/
*.log

# ---- 第三方 JS 库（约 1MB，首次运行会自动重新下载，不必入库）----
assets/

# ---- Python 运行时产物 ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
ENV/

# ---- 编辑器 / 操作系统 ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- 本地密钥：绝对不能提交 ----
# local_secret.py 里存放同花顺 API Key。
# 只提交模板文件 local_secret.py.example。
local_secret.py
*.secret
.env
.env.*

# ---- 计划任务导出文件：含本机绝对路径（用户名等），不公开 ----
# 本地保留用于导入，别人 clone 后按 README 第四节自己建任务即可
task_*.xml

# ---- 临时文件 ----
*.tmp
*.bak
*~

# ============================================================
# 注意：不要在这里加 docs/
# 那会把 GitHub Pages 的入口文件排除掉，导致网页 404。
# ============================================================
